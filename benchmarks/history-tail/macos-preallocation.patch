+def leave_free_space(filler, mount, free_bytes):
+    stat = os.statvfs(mount)
+    to_write = stat.f_bavail * stat.f_frsize - free_bytes
+    assert to_write > 0
+    chunk = os.urandom(1024**2)
+    with filler.open("xb", buffering=0) as file:
+        while to_write:
+            to_write -= file.write(chunk[:to_write])
+        os.fsync(file.fileno())
+
+
+async def low_space_journal_growth(mount):
+    volume = mount / "small-writes"
