+    #[cfg(target_os = "macos")]
+    pub fn reserve_append_extent(&mut self, len: usize) {
+        use std::os::{fd::AsRawFd, unix::fs::MetadataExt};
+
+        const EXTENT: u64 = 1024 * 1024;
+        // Every sealed segment is larger than this, even if the next frame is maximal.
+        const CEILING: u64 = SEGMENT_BYTES - (MAX_STORED_FRAME as u64 + 8);
+        let end = self.end + len as u64 + 8;
+        if end <= self.extent_checked_until || end > CEILING {
+            return;
+        }
+        let target = end.next_multiple_of(EXTENT).min(CEILING);
+        self.extent_checked_until = target;
+        let Ok(meta) = self.file.metadata() else {
+            return;
+        };
+        // On APFS, physical blocks can survive close and reopen beyond the logical EOF.
+        let allocated = meta.blocks().saturating_mul(512).max(meta.len());
+        let additional = target.saturating_sub(allocated).min(EXTENT);
+        if additional == 0
+            || crate::space::available(&self.dir).unwrap_or(0) < 2 * SEGMENT_BYTES + additional
+        {
+            return;
+        }
+        let mut extent = libc::fstore_t {
+            fst_flags: libc::F_ALLOCATEALL,
+            fst_posmode: libc::F_PEOFPOSMODE,
+            fst_offset: 0,
+            fst_length: additional as i64,
+            fst_bytesalloc: 0,
+        };
+        // Best effort. A failed hint leaves the actual write and sync responsible
+        // for reporting ENOSPC and other storage failures to the caller.
+        // SAFETY: fcntl receives a live descriptor and a writable Darwin fstore_t.
+        unsafe { libc::fcntl(self.file.as_raw_fd(), libc::F_PREALLOCATE, &mut extent) };
+    }
