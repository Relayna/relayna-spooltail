+    event = {"task_id": "low-space", "event_id": "one"}
+    async with broker(volume, "shared") as (client, _):
+        leave_free_space(filler, mount, 8 * 1024**2)
+        try:
+            assert (await client.stats()).free_bytes < 16 * 1024**2
+            offset = await client.publish("foreground", event)
+            assert offset == 1
+            raw = (volume / FIRST_RAW).stat()
+            assert 0 < raw.st_size < 4096
+            assert raw.st_blocks * 512 < 1024**2
+        finally:
+            filler.unlink()
+    async with broker(volume, "shared") as (client, _):
+        assert (await client.latest("foreground", "low-space")).event == event
+    shutil.rmtree(volume)
+    print("PASS macOS small append used ordinary growth under disk pressure", flush=True)
