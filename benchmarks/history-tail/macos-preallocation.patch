 }

+#[cfg(target_os = "macos")]
+#[tokio::test]
+async fn journal_reservation_is_bounded_across_reopen() -> Result<()> {
+    use std::os::unix::fs::MetadataExt;
+
+    let dir = tempdir()?;
+    let path = journal::segment_path(dir.path(), 0);
+    for i in 1..=4 {
+        let broker = Broker::new(Store::open(dir.path())?);
+        let id = format!("event-{i}");
+        let position = publish(broker, "status".into(), record(&id), None, None).await?;
+        assert_eq!(position.offset, i);
+        let meta = std::fs::metadata(&path)?;
+        assert!(meta.len() < 4096);
+        assert!(meta.blocks() * 512 <= 1024 * 1024 + meta.blksize());
+    }
+    let mut store = Store::open(dir.path())?;
+    let page = store.page("status", "T7", 0)?;
+    assert_eq!(page.len(), 4);
+    for (n, row) in page.iter().enumerate() {
+        assert_eq!(row.event, record(&format!("event-{}", n + 1)));
+    }
+    store.space.reserve = 1024;
+    assert!(!store.writer_ticket("T7", None)?.reserve_extent);
+    store.space.reserve = 0;
+    store.ensure_partition(1)?;
+    assert!(!store.writer_ticket("T7", None)?.reserve_extent);
+    Ok(())
+}
